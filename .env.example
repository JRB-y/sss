# Copie ce fichier en .env et remplis tes identifiants (le .env n'est jamais commité).
SSS_EMAIL=ton.email@example.com
SSS_PASSWORD=ton-mot-de-passe

# --- Optionnel ---
# Base du site (utile pour pointer un env de test)
# SSS_BASE_URL=https://ssandsun.com
# Navigateur visible (1) ou headless (0, défaut)
# SSS_HEADED=0
# Langue demandée au serveur
# SSS_LOCALE=en
# Forcer les onglets d'historique (sinon détectés automatiquement)
# SSS_DIRS=sent,received
